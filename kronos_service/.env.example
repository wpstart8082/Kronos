# ============================================================
# Kronos 预测服务环境变量模板
# 复制为 kronos_service/.env（本地开发复制到仓库根目录 .env 亦可）
#   cp .env.example .env
# ============================================================

# ---------- 管理后台账号（务必修改密码） ----------
KRONOS_ADMIN_USERNAME=admin
KRONOS_ADMIN_PASSWORD=changeme

# JWT 签名密钥：留空则每次启动随机生成（重启后管理台登录态失效）
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
KRONOS_JWT_SECRET=
KRONOS_JWT_EXPIRE_HOURS=12

# ---------- 服务 ----------
KRONOS_ENV=prod
KRONOS_HOST=0.0.0.0
KRONOS_PORT=8000
KRONOS_LOG_LEVEL=INFO
# 时区（容器内），默认 Asia/Shanghai
TZ=Asia/Shanghai

# ---------- 路径（Docker 内已由 compose 指定，本地开发用默认值即可） ----------
# KRONOS_MODELS_DIR=/models
# KRONOS_INSTANCE_DIR=/app/instance
# KRONOS_LOG_DIR=/app/logs

# ---------- 推理进程（改动需重启容器；业务参数在管理台"系统配置"里热调） ----------
KRONOS_DEVICE=auto              # auto | cuda | cuda:0 | cpu
KRONOS_MAX_CONCURRENT_INFERENCES=1   # 4090 显存充裕可试 2-3
KRONOS_MAX_QUEUE_SIZE=200
KRONOS_SYNC_TIMEOUT_SECONDS=120
KRONOS_TASK_RETENTION_HOURS=24
KRONOS_LOG_RETENTION_DAYS=30

# ---------- 其他 ----------
KRONOS_CORS_ORIGINS=            # 逗号分隔跨域白名单，留空=仅同源
KRONOS_MAX_REQUEST_BODY_MB=20

# ---------- HuggingFace（模型已在 ./models 齐备时可设 1 完全离线启动） ----------
# HF_HUB_OFFLINE=1
